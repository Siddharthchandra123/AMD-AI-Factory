{
  "annotations": {
    "list": []
  },
  "editable": true,
  "title": "AMD AI Factory \u2014 Dynamic GPU Fleet (Simulation / MI300X)",
  "uid": "amd-mission-sim",
  "schemaVersion": 40,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU Utilization (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "mission-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "mission_gpu_utilization_percent",
          "legendFormat": "{{gpu_id}} [{{source}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HBM Usage (GiB)",
      "datasource": {
        "type": "prometheus",
        "uid": "mission-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "mission_gpu_hbm_used_gb",
          "legendFormat": "{{gpu_id}} [{{source}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pending Jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "mission-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "mission_pending_jobs",
          "legendFormat": "Queued",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active Jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "mission-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "mission_running_jobs",
          "legendFormat": "Running",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Scheduler Dispatches by Policy",
      "datasource": {
        "type": "prometheus",
        "uid": "mission-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (placement_policy, queue_policy) (mission_scheduler_dispatches_total)",
          "legendFormat": "{{placement_policy}} / {{queue_policy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Endpoint Ready (1/0)",
      "datasource": {
        "type": "prometheus",
        "uid": "mission-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "mission_endpoint_available",
          "legendFormat": "{{mode}} {{gpu_id}} {{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Actual vLLM Completion Tokens / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "mission-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(mission_completion_tokens_total[1m])",
          "legendFormat": "{{mode}} {{gpu_id}} {{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Real vs Simulated Completed Jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "mission-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (mode) (mission_completed_jobs_total)",
          "legendFormat": "{{mode}} {{gpu_id}} {{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Inference Job Duration (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "mission-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(mission_job_duration_seconds_bucket[5m])))",
          "legendFormat": "{{mode}} {{gpu_id}} {{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}